/node_modules
/playlists

# Secret config — copy from the .example files and fill in locally.
# These should never be committed because they contain bot tokens and Plex tokens.
/config/keys.js
/config/plex.js

# Runtime state under data/ that is specific to your install, not to the code.
# config.overrides.json holds whatever the /config wizard saved, including the fields it
# treats as secret (Tautulli API key, event server token) and your Discord IDs.
# logs/ holds the bot log and the command log, which record message content verbatim.
# archipelago_watches.json holds room URLs, channel/user IDs, and a room password if set.
/data/config.overrides.json
/data/logs/
/data/archipelago_watches.json
/data/archipelago/
/data/inferred_tags.json
/data/recent_picks.json

# Player data written by the games and AI commands. Every one of these is keyed by Discord
# user ID and belongs to whoever runs the bot, not to the code.
/data/character_sheets.json
/data/characters.json
/data/hitster_stats.json
/data/kometa_theater.json
/data/*_leaderboard.json
/data/clues/
# Older builds wrote some of the same files next to the config or at the project root.
/config/*_leaderboard.json
/config/hitster_stats.json
/config/plex_requests.json
/character_sheets.json
/playtime_stats.json

# Local tooling and scratch files that end up in the project root.
/.claude/
/.idea/
*.lnk
*-player-script.js
